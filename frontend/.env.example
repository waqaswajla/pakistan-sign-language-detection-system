# Copy this file to .env.local and fill in the values.

# Backend FastAPI server the frontend talks to for detection/streaming.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# NextAuth (Auth.js) — Google sign-in.
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Stripe donations. Leave blank to disable the /donate page's checkout.
STRIPE_SECRET_KEY=
